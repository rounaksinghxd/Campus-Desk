# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the Admin Panel.
# If left empty, the first user to open the Admin Panel can claim an initial passcode.
ADMIN_PASSCODE=

# SESSION_SECRET: Required in production so faculty/admin Bearer tokens stay valid across restarts.
SESSION_SECRET=

# VITE_API_BASE_URL: Required when building the Android APK (Capacitor) to point to your deployed HTTPS backend.
# Example: https://campusdesk-api.onrender.com
# Leave empty when serving the frontend and backend from the same Express server.
VITE_API_BASE_URL=

# CORS_ALLOWED_ORIGINS: Optional comma-separated origins allowed by Express CORS middleware.
# Capacitor origins (https://localhost, capacitor://localhost, http://localhost) are already permitted.
CORS_ALLOWED_ORIGINS=

